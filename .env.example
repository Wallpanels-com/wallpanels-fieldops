# Required: set these ONLY in Railway Variables / local .env (never commit secrets)
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-service.up.railway.app
TELEGRAM_BOT_TOKEN=REPLACE_WITH_CURRENT_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME_WITHOUT_AT
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_CURRENT_SB_SECRET
BOOTSTRAP_ADMIN_TELEGRAM_ID=YOUR_NUMERIC_TELEGRAM_ID
# Comma-separated numeric Telegram IDs only. Usernames never grant manager rights.
MANAGER_TELEGRAM_IDS=
SESSION_SECRET=REPLACE_WITH_RANDOM_64_PLUS_CHAR_VALUE
# Optional: only used in development and NEVER in production
ALLOW_DEV_AUTH=false
DEV_AUTH_TG_ID=
